# -*- coding: utf-8 -*-
"""
FreeCAD CAM Macro - STL Surface V2

V2 starts from the existing V1 operation, but delegates XY strategy
generation to FreeCAD CAM's PathGeometryGenerator whenever possible.

Current goal:
    STL/Mesh -> FreeCAD CAM strategy -> OCL PathDropCutter -> Path -> Job

Supported strategy names in this first V2 implementation:
    Line
    Zigzag
    Circular
    Circular Zigzag
    Offset
    Spiral

The strategy geometry is generated by FreeCAD's own
Path.Op.SurfaceSupport.PathGeometryGenerator.

This is deliberately a V2 development file. V1 remains untouched.
"""

import math

import FreeCAD
import FreeCADGui
import Path
import Path.Op.Custom as custom
import Path.Op.Gui.Base as GuiBase
from Path.Op.Gui.Base import CommandResources, TaskPanelPage
from Path.Base import FeedRate
from PySide6 import QtWidgets, QtCore
from opencamlib import ocl

try:
    from Path.Op.SurfaceSupport import PathGeometryGenerator
except Exception:
    PathGeometryGenerator = None


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def get_selected_mesh():
    sel = FreeCADGui.Selection.getSelection()
    if len(sel) != 1:
        QtWidgets.QMessageBox.critical(
            None,
            "STL Surface V2",
            "Select exactly ONE STL/Mesh object before starting the macro.",
        )
        return None

    obj = sel[0]
    if not obj.TypeId.startswith("Mesh"):
        QtWidgets.QMessageBox.critical(
            None,
            "STL Surface V2",
            "The selected object must be a Mesh/STL object.",
        )
        return None

    return obj


def find_job(doc):
    job = doc.getObject("Job")
    if job:
        return job

    for obj in doc.Objects:
        try:
            if obj.Name == "Job" or obj.Label == "Job":
                return obj
        except Exception:
            pass

    QtWidgets.QMessageBox.critical(
        None,
        "STL Surface V2",
        "No CAM Job was found in the active document.",
    )
    return None


def get_tool_controllers(job):
    result = []
    try:
        if job and job.Tools and job.Tools.Group:
            result.extend(job.Tools.Group)
    except Exception as exc:
        FreeCAD.Console.PrintError(
            "STL Surface V2: cannot read Job tools: %s\\n" % exc
        )
    return result


def make_ocl_surface(mesh_obj):
    surface = ocl.STLSurf()

    for facet in mesh_obj.Mesh.Facets:
        p1, p2, p3 = facet.Points
        surface.addTriangle(
            ocl.Triangle(
                ocl.Point(*p1),
                ocl.Point(*p2),
                ocl.Point(*p3),
            )
        )

    return surface


def make_ocl_cutter(tool):
    shape_id = getattr(tool, "ShapeID", "")

    if shape_id == "endmill":
        return ocl.CylCutter(tool.Diameter.Value, tool.Length.Value)

    if shape_id == "ballend":
        return ocl.BallCutter(tool.Diameter.Value, tool.Length.Value)

    if shape_id == "bullnose":
        return ocl.BullCutter(
            tool.Diameter.Value,
            tool.CornerRadius.Value,
            tool.CuttingEdgeHeight.Value,
        )

    if shape_id == "v-bit":
        return ocl.ConeCutter(
            tool.Diameter.Value,
            tool.CuttingEdgeAngle.Value / 2.0,
            tool.CuttingEdgeHeight.Value,
        )

    raise RuntimeError("Unsupported OCL cutter type: %s" % shape_id)


def remove_collinear(points, tol=1e-7):
    if len(points) < 3:
        return points

    result = [points[0]]

    for i in range(1, len(points) - 1):
        v1 = points[i] - result[-1]
        v2 = points[i + 1] - points[i]

        if v1.cross(v2).Length > tol:
            result.append(points[i])

    result.append(points[-1])
    return result


def make_planar_bbox(mesh_obj, margin=0.0, allowance_xy=0.0):
    """Create the planar XY region used by FreeCAD's strategy generator.

    OCL still receives the complete STL. The planar shape is only used to
    generate the XY strategy.
    """
    import Part

    bb = mesh_obj.Mesh.BoundBox

    xmin = bb.XMin - margin + allowance_xy
    xmax = bb.XMax + margin - allowance_xy
    ymin = bb.YMin - margin + allowance_xy
    ymax = bb.YMax + margin - allowance_xy

    if xmax <= xmin or ymax <= ymin:
        raise RuntimeError("Margin/Allowance XY leaves no usable machining area.")

    p1 = FreeCAD.Vector(xmin, ymin, 0)
    p2 = FreeCAD.Vector(xmax, ymin, 0)
    p3 = FreeCAD.Vector(xmax, ymax, 0)
    p4 = FreeCAD.Vector(xmin, ymax, 0)

    edges = [
        Part.makeLine(p1, p2),
        Part.makeLine(p2, p3),
        Part.makeLine(p3, p4),
        Part.makeLine(p4, p1),
    ]
    return Part.Face(Part.Wire(edges))


class StrategyAdapter:
    """Minimal property adapter expected by FreeCAD's PathGeometryGenerator."""

    def __init__(self, tool_controller, step_over, sampling, cut_mode="Climb"):
        self.ToolController = tool_controller
        self.StepOver = float(step_over)
        self.SampleInterval = sampling
        self.CutMode = cut_mode
        self.CutPatternReversed = False
        self.CutPatternAngle = 0.0
        self.PatternCenterAt = "CenterOfBoundBox"
        self.PatternCenterCustom = FreeCAD.Vector(0, 0, 0)


def strategy_to_ocl_path(geometry, sampling):
    """Convert FreeCAD-generated strategy geometry into an OCL Path.

    FreeCAD remains responsible for generating the strategy. We only convert
    its planar edges to OCL line segments before the surface projection.
    """
    ocl_path = ocl.Path()

    edges = list(getattr(geometry, "Edges", []))
    if not edges:
        raise RuntimeError("FreeCAD strategy generated no usable edges.")

    for edge in edges:
        try:
            pts = edge.discretize(Distance=max(float(sampling), 0.001))
        except Exception:
            pts = [v.Point for v in edge.Vertexes]

        if len(pts) < 2:
            continue

        for p1, p2 in zip(pts[:-1], pts[1:]):
            if (p2 - p1).Length <= 1e-9:
                continue

            ocl_path.append(
                ocl.Line(
                    ocl.Point(p1.x, p1.y, 0.0),
                    ocl.Point(p2.x, p2.y, 0.0),
                )
            )

    return ocl_path


# ---------------------------------------------------------------------------
# Dialog
# ---------------------------------------------------------------------------

class SurfaceV2Dialog(QtWidgets.QDialog):
    def __init__(self, job, mesh_obj):
        super().__init__()
        self.setWindowTitle("STL Surface V2")
        self.setMinimumWidth(430)

        layout = QtWidgets.QFormLayout(self)

        self.source = QtWidgets.QLabel(mesh_obj.Label)
        self.job_label = QtWidgets.QLabel(job.Label)

        self.strategy = QtWidgets.QComboBox()
        self.strategy.addItems([
            "Line",
            "Zigzag",
            "Circular",
            "Circular Zigzag",
            "Offset",
            "Spiral",
        ])

        self.mode = QtWidgets.QComboBox()
        self.mode.addItems(["Roughing", "Finishing"])

        self.step_over = QtWidgets.QDoubleSpinBox()
        self.step_over.setRange(0.01, 1000.0)
        self.step_over.setValue(2.0)
        self.step_over.setDecimals(3)

        self.step_down = QtWidgets.QDoubleSpinBox()
        self.step_down.setRange(0.001, 10000.0)
        self.step_down.setValue(1.0)
        self.step_down.setDecimals(3)

        self.depth = QtWidgets.QDoubleSpinBox()
        self.depth.setRange(0.001, 10000.0)
        self.depth.setValue(1.0)
        self.depth.setDecimals(3)

        self.allowance_xy = QtWidgets.QDoubleSpinBox()
        self.allowance_xy.setRange(0.0, 1000.0)
        self.allowance_xy.setValue(0.0)
        self.allowance_xy.setDecimals(3)

        self.allowance_z = QtWidgets.QDoubleSpinBox()
        self.allowance_z.setRange(0.0, 1000.0)
        self.allowance_z.setValue(0.0)
        self.allowance_z.setDecimals(3)

        self.margin = QtWidgets.QDoubleSpinBox()
        self.margin.setRange(0.0, 1000.0)
        self.margin.setValue(0.0)
        self.margin.setDecimals(3)

        self.sampling = QtWidgets.QDoubleSpinBox()
        self.sampling.setRange(0.01, 100.0)
        self.sampling.setValue(1.0)
        self.sampling.setDecimals(3)

        self.direction = QtWidgets.QComboBox()
        self.direction.addItems(["X", "Y"])

        self.layout = layout
        layout.addRow("STL:", self.source)
        layout.addRow("Job:", self.job_label)
        layout.addRow("Strategy:", self.strategy)
        layout.addRow("Mode:", self.mode)
        layout.addRow("Step Over:", self.step_over)
        layout.addRow("Step Down:", self.step_down)
        layout.addRow("Depth Limit:", self.depth)
        layout.addRow("Allowance XY:", self.allowance_xy)
        layout.addRow("Allowance Z:", self.allowance_z)
        layout.addRow("Margin:", self.margin)
        layout.addRow("OCL Sampling:", self.sampling)
        layout.addRow("Direction:", self.direction)

        buttons = QtWidgets.QDialogButtonBox(
            QtWidgets.QDialogButtonBox.Ok | QtWidgets.QDialogButtonBox.Cancel
        )
        buttons.accepted.connect(self.accept)
        buttons.rejected.connect(self.reject)
        layout.addRow(buttons)

        self.mode.currentTextChanged.connect(self.update_mode)
        self.update_mode(self.mode.currentText())

    def update_mode(self, mode):
        finishing = mode == "Finishing"
        self.step_down.setEnabled(not finishing)
        self.allowance_xy.setEnabled(not finishing)
        self.allowance_z.setEnabled(not finishing)

        if finishing:
            self.step_down.setValue(self.depth.value())
            self.allowance_xy.setValue(0.0)
            self.allowance_z.setValue(0.0)

    def values(self):
        return {
            "strategy": self.strategy.currentText(),
            "mode": self.mode.currentText(),
            "stepover": self.step_over.value(),
            "stepdown": self.step_down.value(),
            "depth": self.depth.value(),
            "allowance_xy": self.allowance_xy.value(),
            "allowance_z": self.allowance_z.value(),
            "margin": self.margin.value(),
            "sampling": self.sampling.value(),
            "direction": self.direction.currentText(),
        }


# ---------------------------------------------------------------------------
# Custom operation
# ---------------------------------------------------------------------------

class SurfaceV2Proxy:
    pass


def create_operation(job, mesh_obj, tool_controller, params):
    name = "STL_Surface_V2"

    op = custom.Create(name, parentJob=job)

    if not hasattr(op, "Proxy") or not isinstance(op.Proxy, custom.ObjectCustom):
        custom.ObjectCustom(op)

    if FreeCAD.GuiUp:
        resources = CommandResources(
            name="STL Surface V2",
            objFactory=custom.Create,
            opPageClass=TaskPanelPage,
            pixmap="CAM_Custom",
            menuText="STL Surface V2",
            accelKey="",
            toolTip="FreeCAD strategy + OpenCAMLib STL surface operation",
        )
        op.ViewObject.Proxy = GuiBase.ViewProvider(op.ViewObject, resources)

    def add_prop(prop_type, name, group, desc=""):
        if not hasattr(op, name):
            op.addProperty(prop_type, name, group, desc)

    add_prop("App::PropertyBool", "IsCustomOp", "Path")
    add_prop("App::PropertyLink", "STLSource", "Geometry")
    add_prop("App::PropertyLink", "ToolController", "Path")
    add_prop("App::PropertyString", "Strategy", "Strategy")
    add_prop("App::PropertyString", "Mode", "Strategy")
    add_prop("App::PropertyDistance", "DepthLimit", "Parameters")
    add_prop("App::PropertyDistance", "StepDown", "Parameters")
    add_prop("App::PropertyDistance", "StepOver", "Parameters")
    add_prop("App::PropertyDistance", "AllowanceXY", "Parameters")
    add_prop("App::PropertyDistance", "AllowanceZ", "Parameters")
    add_prop("App::PropertyDistance", "Margin", "Parameters")
    add_prop("App::PropertyDistance", "Sampling", "Parameters")
    add_prop("App::PropertyString", "Direction", "Strategy")

    op.IsCustomOp = True
    op.STLSource = mesh_obj
    op.ToolController = tool_controller
    op.Strategy = params["strategy"]
    op.Mode = params["mode"]
    op.DepthLimit = params["depth"]
    op.StepDown = params["stepdown"]
    op.StepOver = params["stepover"]
    op.AllowanceXY = params["allowance_xy"]
    op.AllowanceZ = params["allowance_z"]
    op.Margin = params["margin"]
    op.Sampling = params["sampling"]
    op.Direction = params["direction"]

    return op


# ---------------------------------------------------------------------------
# Toolpath generation
# ---------------------------------------------------------------------------

def generate_toolpath(mesh_obj, tool_controller, params, job, progress=None):
    if PathGeometryGenerator is None:
        raise RuntimeError(
            "FreeCAD PathGeometryGenerator is not available in this installation."
        )

    def update_progress(value, message):
        if progress is None:
            return
        progress.setValue(max(0, min(100, int(value))))
        progress.setLabelText(message)
        QtWidgets.QApplication.processEvents()
        if progress.wasCanceled():
            raise RuntimeError("Calculation cancelled by user")

    tool = tool_controller.Tool
    cutter = make_ocl_cutter(tool)
    surface = make_ocl_surface(mesh_obj)

    planar_shape = make_planar_bbox(
        mesh_obj,
        params["margin"],
        params["allowance_xy"],
    )

    adapter = StrategyAdapter(
        tool_controller,
        params["stepover"],
        params["sampling"],
    )

    strategy_name = params["strategy"]
    if strategy_name == "Circular Zigzag":
        generator_name = "CircularZigZag"
    else:
        generator_name = strategy_name

    update_progress(5, "Generating FreeCAD %s strategy..." % strategy_name)

    generator = PathGeometryGenerator(
        adapter,
        planar_shape,
        generator_name,
    )

    geometry = generator.generatePathGeometry()
    if not geometry:
        raise RuntimeError(
            "FreeCAD did not generate usable geometry for strategy %s."
            % strategy_name
        )

    update_progress(20, "Converting FreeCAD strategy to OCL path...")

    ocl_path = strategy_to_ocl_path(
        geometry,
        params["sampling"],
    )

    update_progress(30, "Running OpenCAMLib DropCutter...")

    bb = mesh_obj.Mesh.BoundBox
    top_z = bb.ZMax
    final_z = top_z - params["depth"] + params["allowance_z"]

    if params["mode"] == "Finishing":
        passes = [final_z]
    else:
        step_down = max(params["stepdown"], 0.001)
        count = max(1, int(math.ceil(params["depth"] / step_down)))
        passes = []
        for i in range(count):
            z = top_z - min(params["depth"], (i + 1) * step_down)
            passes.append(z + params["allowance_z"])

    safe_z = top_z
    commands = []

    for pass_index, pass_z in enumerate(passes):
        update_progress(
            30 + (pass_index * 60.0 / max(1, len(passes))),
            "OCL DropCutter: pass %d/%d..." %
            (pass_index + 1, len(passes)),
        )

        pdc = ocl.PathDropCutter()
        pdc.setSTL(surface)
        pdc.setCutter(cutter)
        pdc.setZ(pass_z)
        pdc.setSampling(params["sampling"])
        pdc.setPath(ocl_path)
        pdc.run()

        cl_points = pdc.getCLPoints()
        points = [
            FreeCAD.Vector(p.x, p.y, p.z)
            for p in cl_points
        ]
        points = remove_collinear(points)

        if not points:
            continue

        commands.append(Path.Command("G0", {"Z": safe_z}))
        commands.append(
            Path.Command(
                "G0",
                {"X": points[0].x, "Y": points[0].y, "Z": pass_z},
            )
        )

        for p in points:
            cut_z = max(p.z + params["allowance_z"], pass_z)
            commands.append(
                Path.Command(
                    "G1",
                    {"X": p.x, "Y": p.y, "Z": cut_z},
                )
            )

    commands.append(Path.Command("G0", {"Z": safe_z}))

    try:
        FeedRate.setFeedRate(commands, tool_controller)
    except Exception as exc:
        FreeCAD.Console.PrintError(
            "STL Surface V2: FeedRate failed: %s\\n" % exc
        )

    update_progress(100, "STL Surface V2 complete.")
    return commands


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main():
    if not FreeCAD.GuiUp:
        raise RuntimeError("STL Surface V2 requires the FreeCAD GUI.")

    doc = FreeCAD.ActiveDocument
    if doc is None:
        QtWidgets.QMessageBox.critical(
            None,
            "STL Surface V2",
            "No active FreeCAD document.",
        )
        return

    mesh_obj = get_selected_mesh()
    if mesh_obj is None:
        return

    job = find_job(doc)
    if job is None:
        return

    dlg = SurfaceV2Dialog(job, mesh_obj)
    if dlg.exec() != QtWidgets.QDialog.Accepted:
        return

    params = dlg.values()
    controllers = get_tool_controllers(job)

    if not controllers:
        QtWidgets.QMessageBox.critical(
            None,
            "STL Surface V2",
            "No Tool Controller was found in the Job.",
        )
        return

    labels = [tc.Label for tc in controllers]
    selected_label, ok = QtWidgets.QInputDialog.getItem(
        None,
        "Sélection de l'outil",
        "Contrôleur d'outil :",
        labels,
        0,
        False,
    )
    if not ok:
        return

    tool_controller = controllers[labels.index(selected_label)]

    progress = QtWidgets.QProgressDialog(
        "Preparing...",
        "Cancel",
        0,
        100,
    )
    progress.setWindowTitle("STL Surface V2")
    progress.setWindowModality(QtCore.Qt.WindowModal)
    progress.setMinimumDuration(0)
    progress.setValue(0)
    progress.show()
    QtWidgets.QApplication.processEvents()

    try:
        commands = generate_toolpath(
            mesh_obj,
            tool_controller,
            params,
            job,
            progress,
        )

        if not commands:
            raise RuntimeError("No toolpath was generated.")

        op = create_operation(
            job,
            mesh_obj,
            tool_controller,
            params,
        )

        op.Path = Path.Path(commands)

        doc.recompute()
        FreeCADGui.activeDocument().activeView().fitAll()

        FreeCAD.Console.PrintMessage(
            "STL Surface V2: operation '%s' created with strategy '%s'.\\n"
            % (op.Label, params["strategy"])
        )

    except Exception as exc:
        FreeCAD.Console.PrintError(
            "STL Surface V2 ERROR: %s\\n" % exc
        )
        QtWidgets.QMessageBox.critical(
            None,
            "STL Surface V2",
            str(exc),
        )

    finally:
        progress.close()
        progress.deleteLater()


main()
